{
	"compatibility_date": "2026-05-08",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "ranarium-hp",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// 平文の環境変数はここが正本。`wrangler deploy` は vars を丸ごと上書きするため、
	// ここに書かれていない平文変数はデプロイのたびに削除される
	// (実際に CONTACT_TO / CONTACT_FROM が消えて問い合わせフォームが停止した)。
	// 平文でよい値は必ずここに書き、秘匿値 (RESEND_API_KEY) は Secret で登録する
	// — Secret はデプロイの影響を受けない。
	//
	// ALERT_TO (送信失敗の通知先) は Secret で登録している。
	// このリポジトリは公開されており、担当者個人のアドレスを晒さないため。
	// 未設定でも src/lib/alert.ts が info@rana-rium.com にフォールバックする。
	"vars": {
		"CONTACT_TO": "info@rana-rium.com",
		"CONTACT_FROM": "RANARIUM <noreply@rana-rium.com>"
	},
	"observability": {
		"enabled": true
	}
}