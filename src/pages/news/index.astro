---
import Layout from '../../layouts/Layout.astro';
import { articles, categories } from '../../data/news';
---

<Layout title="お知らせ" description="株式会社RANARIUMのお知らせ・プレスリリース一覧。最新情報はこちらでご確認ください。">

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a><span>/</span><span>お知らせ</span>
      </nav>
      <div class="page-hero-inner animate-fade-in-up">
        <p class="section-label">News</p>
        <h1 class="page-title">お知らせ</h1>
        <p class="page-subtitle">RANARIUMの最新情報をお届けします。</p>
      </div>
    </div>
  </section>

  <!-- News List -->
  <section class="section news-list-section">
    <div class="container">

      <!-- Category filter -->
      <div class="cat-filter" data-animate>
        {categories.map(c => (
          <button
            class={`cat-btn ${c === 'すべて' ? 'active' : ''}`}
            data-cat={c}
          >
            {c}
          </button>
        ))}
      </div>

      <!-- Articles -->
      <div class="articles-list" id="articles-list">
        {articles.map((a, i) => (
          <a
            href={`/news/${a.slug}`}
            class="article-card"
            data-animate
            data-cat={a.cat}
            style={`animation-delay: ${i * 0.07}s`}
          >
            <div class="article-inner">
              <div class="article-meta">
                <time datetime={a.date} class="article-date">{a.dateDisplay}</time>
                <span class="tag">{a.cat}</span>
              </div>
              <h2 class="article-title">{a.title}</h2>
              <p class="article-desc">{a.desc}</p>
              <span class="article-read-more">
                続きを読む
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 140px 0 40px;
    position: relative;
    overflow: hidden;
    background: transparent;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    margin-bottom: 32px;
  }
  .breadcrumb a { color: var(--color-ink-muted); text-decoration: none; transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--color-ink); }

  .page-hero-inner { max-width: 720px; }

  .page-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.95;
  }

  /* News list */
  .news-list-section {
    background: transparent;
    padding-top: 24px;
  }

  .cat-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
  }

  .cat-btn {
    padding: 8px 20px;
    border-radius: 2px;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: 0.04em;
  }

  .cat-btn:hover {
    border-color: var(--color-ink-soft);
    color: var(--color-ink);
  }

  .cat-btn.active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #ffffff;
  }

  .articles-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .article-card {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    background: #ffffff;
    border: 1px solid var(--color-border);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s, border-color 0.35s;
  }

  .article-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-ink-soft);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
  }

  .article-card[data-hidden] { display: none; }

  .article-inner {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .article-date {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-ink-muted);
    letter-spacing: 0.06em;
  }

  .article-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--color-ink);
    transition: color 0.2s;
    letter-spacing: -0.01em;
  }

  .article-card:hover .article-title { color: var(--color-ink-soft); }

  .article-desc {
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    line-height: 1.85;
    flex: 1;
  }

  .article-read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-ink);
    font-family: var(--font-body);
    letter-spacing: 0.08em;
    transition: gap 0.2s;
  }

  .article-card:hover .article-read-more { gap: 12px; }

  @media (max-width: 640px) {
    .articles-list { grid-template-columns: 1fr; }
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const cards = document.querySelectorAll<HTMLElement>('.article-card');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const cat = btn.dataset.cat;
      cards.forEach(card => {
        if (cat === 'すべて' || card.dataset.cat === cat) {
          card.removeAttribute('data-hidden');
        } else {
          card.setAttribute('data-hidden', '');
        }
      });
    });
  });
</script>
