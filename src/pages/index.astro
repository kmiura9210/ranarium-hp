---
import Layout from '../layouts/Layout.astro';
---

<Layout title="トップ">

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container hero-content">
      <div class="hero-text">
        <p class="hero-eyebrow animate-fade-in-up">
          <span class="hero-eyebrow-line"></span>
          rana × rium
        </p>

        <h1 class="hero-heading animate-fade-in-up delay-200">
          <span class="hero-heading-ja">
            跳ぶ者を、<br/>育てる水槽。
          </span>
        </h1>

        <p class="hero-body animate-fade-in-up delay-400">
          Leapfrogが育つ水槽として、<br class="hero-br"/>
          AI・ITで、「跳躍する事業」を育てていく。
        </p>

        <div class="hero-actions animate-fade-in-up delay-600">
          <a href="/contact" class="btn-primary">
            お問い合わせ
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="/services" class="btn-outline">
            サービスを見る
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator-wrap">
      <span class="scroll-label">SCROLL</span>
      <span class="scroll-line"></span>
    </div>
  </section>

  <!-- ===== SOLUTION ===== -->
  <section class="section solution-section">
    <div class="container">
      <div class="section-header-2col" data-animate>
        <div class="section-heading-block">
          <p class="section-eyebrow">SOLUTION</p>
          <h2 class="section-title-2">
            事業を跳ばす、<br/>
            3つの専門性。
          </h2>
        </div>
        <p class="section-lead">
          ビジネスモデルの設計から、プロダクトの実装、AI活用まで。
          新規事業を跳躍させるために必要な専門性を、一気通貫で提供します。
          コンサルにとどまらず、現場で手を動かして伴走します。
        </p>
      </div>

      <div class="solution-grid">
        {[
          {
            num: '01',
            en: 'Business Development',
            title: '新規事業開発',
            desc: 'ビジネスモデルの設計から、市場検証、事業計画策定、投資家向け資料作成まで。「何をやるか」を決める上流から、跳躍する事業の輪郭を描きます。',
            tags: ['#ビジネスモデル', '#事業計画', '#市場検証', '#KPI設計'],
            href: '/services#biz',
          },
          {
            num: '02',
            en: 'Product Management',
            title: 'プロダクト開発PdM',
            desc: '要件定義、開発ベンダー選定、進行管理から、リリース後のグロース運用まで。スタートアップから大企業の新規事業部門まで、幅広い経験を活かしてプロダクトを形にします。',
            tags: ['#PdM', '#要件定義', '#開発推進', '#グロース運用'],
            href: '/services#pdm',
          },
          {
            num: '03',
            en: 'AI Consulting',
            title: 'AIコンサルティング',
            desc: '戦略の絵を描くだけでなく、PoC実装、運用への定着まで踏み込みます。生成AIブームに振り回されず、「使えるAI活用」を設計・実装します。',
            tags: ['#AI戦略', '#PoC設計', '#生成AI実装', '#運用定着'],
            href: '/services#ai',
          },
        ].map(s => (
          <a href={s.href} class="solution-card" data-animate>
            <div class="solution-card-top">
              <span class="solution-num">{s.num}</span>
              <span class="solution-en">{s.en}</span>
            </div>
            <h3 class="solution-title">{s.title}</h3>
            <p class="solution-desc">{s.desc}</p>
            <ul class="solution-tags">
              {s.tags.map(t => <li>{t}</li>)}
            </ul>
            <span class="solution-arrow">
              VIEW MORE
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== STRENGTHS ===== -->
  <section class="section strengths-section">
    <div class="container">
      <div class="section-header-2col" data-animate>
        <div class="section-heading-block">
          <p class="section-eyebrow">STRENGTHS</p>
          <h2 class="section-title-2">
            選ばれる、<br/>
            3つの理由。
          </h2>
        </div>
        <p class="section-lead">
          私たちは「請け負う」のではなく、お客様の事業に深く踏み込み、共に跳躍を生み出します。
          受託の枠を超えた3つの姿勢が、RANARIUMの強みです。
        </p>
      </div>

      <div class="strengths-grid" data-animate>
        {[
          {
            num: '01',
            title: '自分ごとで、伴走する。',
            desc: 'お客様の事業を、自分たちの事業として捉える。短期の納品ではなく、長期の成長にコミットします。意思決定の場に同席し、悩みも勝ちも分かち合うパートナーであり続けます。',
          },
          {
            num: '02',
            title: '手段ではなく、目的から。',
            desc: 'テクノロジーは目的ではなく手段。「何を成し遂げたいか」から逆算し、最適な技術を選定します。導入して終わりではなく、運用・改善まで一貫して伴走します。',
          },
          {
            num: '03',
            title: '事業者として、リスクを取る。',
            desc: '私たち自身も事業を立ち上げ、運営しています。資本も時間もリスクも投じる中で得た「現場の知」を、お客様の現場へ。理論ではなく、実装の知見をお届けします。',
          },
        ].map(s => (
          <article class="strength-card">
            <div class="strength-num">{s.num}</div>
            <h3 class="strength-title">{s.title}</h3>
            <p class="strength-desc">{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== WORK ===== -->
  <section class="section work-section">
    <div class="container">
      <div class="section-header-2col" data-animate>
        <div class="section-heading-block">
          <p class="section-eyebrow">WORK</p>
          <h2 class="section-title-2">
            共に創る、<br/>
            実績と事例。
          </h2>
        </div>
        <p class="section-lead">
          決済、金融、エンタメ、ブロックチェーンまで。
          業界を超えて、多くのプロジェクトに伴走してきました。
          そこで培った知見と方法論が、次の挑戦の礎となります。
        </p>
      </div>

      <div class="work-grid">
        {[
          {
            category: 'AI',
            title: 'AIエンタメチャットシステム',
            client: 'エンタメ企業',
            tags: ['#AI開発', '#チャットシステム'],
            svg: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg"><rect width="400" height="300" fill="#1d1d1f"/><rect x="60" y="70" width="190" height="110" rx="16" fill="none" stroke="#ffffff" stroke-opacity="0.85" stroke-width="2"/><path d="M 100 180 L 90 200 L 130 180 Z" fill="#ffffff" fill-opacity="0.85"/><line x1="90" y1="105" x2="200" y2="105" stroke="#ffffff" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round"/><line x1="90" y1="130" x2="220" y2="130" stroke="#ffffff" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round"/><line x1="90" y1="155" x2="170" y2="155" stroke="#ffffff" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round"/><rect x="220" y="170" width="130" height="70" rx="14" fill="#3e86fa"/><path d="M 320 240 L 335 252 L 310 240 Z" fill="#3e86fa"/><line x1="240" y1="200" x2="320" y2="200" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-opacity="0.85"/><line x1="240" y1="220" x2="290" y2="220" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-opacity="0.6"/><g stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-opacity="0.85"><path d="M 295 50 L 295 80 M 280 65 L 310 65"/></g></svg>`,
          },
          {
            category: 'ブロックチェーン',
            title: 'NFT発行プラットフォーム',
            client: 'エンタメ企業',
            tags: ['#ブロックチェーン', '#NFT'],
            svg: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg"><rect width="400" height="300" fill="#1d1d1f"/><g transform="translate(200,160)"><path d="M -75 -40 L 0 -80 L 0 40 L -75 0 Z" fill="#ffffff" fill-opacity="0.12" stroke="#ffffff" stroke-opacity="0.85" stroke-width="2"/><path d="M 75 -40 L 0 -80 L 0 40 L 75 0 Z" fill="#3e86fa"/><path d="M 0 -80 L 75 -40 L 0 0 L -75 -40 Z" fill="#ffffff" fill-opacity="0.85"/></g><g stroke="#ffffff" stroke-opacity="0.4" stroke-width="1.5" fill="none"><rect x="60" y="60" width="22" height="22" transform="rotate(15 71 71)"/><rect x="320" y="220" width="16" height="16" transform="rotate(-10 328 228)"/><rect x="340" y="80" width="14" height="14" transform="rotate(20 347 87)"/></g></svg>`,
          },
          {
            category: '新規事業',
            title: 'ウォレットアプリ',
            client: '自社プロダクト',
            tags: ['#Web3', '#ウォレット', '#決済'],
            svg: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg"><rect width="400" height="300" fill="#1d1d1f"/><g transform="rotate(-10 180 160)"><rect x="80" y="100" width="200" height="120" rx="14" fill="#1d1d1f" stroke="#ffffff" stroke-opacity="0.85" stroke-width="2"/><rect x="100" y="120" width="36" height="24" rx="3" fill="#ffffff" fill-opacity="0.6"/><line x1="100" y1="180" x2="180" y2="180" stroke="#ffffff" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round"/><line x1="100" y1="195" x2="160" y2="195" stroke="#ffffff" stroke-opacity="0.4" stroke-width="2" stroke-linecap="round"/></g><g transform="rotate(6 240 180)"><rect x="140" y="120" width="200" height="120" rx="14" fill="#ffffff" fill-opacity="0.95"/><rect x="160" y="140" width="36" height="24" rx="3" fill="#1d1d1f" fill-opacity="0.7"/><line x1="160" y1="200" x2="240" y2="200" stroke="#1d1d1f" stroke-opacity="0.6" stroke-width="2" stroke-linecap="round"/><line x1="160" y1="215" x2="210" y2="215" stroke="#1d1d1f" stroke-opacity="0.4" stroke-width="2" stroke-linecap="round"/></g><circle cx="320" cy="80" r="32" fill="#3e86fa"/><circle cx="320" cy="80" r="22" fill="none" stroke="#ffffff" stroke-width="2"/></svg>`,
          },
          {
            category: '社内システム開発',
            title: '顧客管理システムの新規導入',
            client: '金融サービス',
            tags: ['#Webアプリ', '#社内システム', '#DX'],
            svg: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg"><rect width="400" height="300" fill="#1d1d1f"/><g stroke="#ffffff" stroke-opacity="0.3" stroke-width="1.5"><line x1="60" y1="80" x2="340" y2="80"/><line x1="60" y1="120" x2="340" y2="120"/><line x1="60" y1="160" x2="340" y2="160"/><line x1="60" y1="200" x2="340" y2="200"/><line x1="60" y1="240" x2="340" y2="240"/></g><g fill="#ffffff" fill-opacity="0.85"><circle cx="82" cy="100" r="9"/><circle cx="82" cy="140" r="9"/><circle cx="82" cy="220" r="9"/></g><g stroke="#ffffff" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round"><line x1="105" y1="100" x2="220" y2="100"/><line x1="105" y1="140" x2="190" y2="140"/><line x1="105" y1="220" x2="240" y2="220"/></g><g stroke="#ffffff" stroke-opacity="0.25" stroke-width="2" stroke-linecap="round"><line x1="240" y1="100" x2="300" y2="100"/><line x1="210" y1="140" x2="270" y2="140"/><line x1="260" y1="220" x2="310" y2="220"/></g><rect x="60" y="170" width="280" height="30" fill="#3e86fa"/><circle cx="82" cy="185" r="9" fill="#1d1d1f"/><line x1="105" y1="183" x2="220" y2="183" stroke="#1d1d1f" stroke-width="2.5" stroke-linecap="round"/><line x1="105" y1="192" x2="180" y2="192" stroke="#1d1d1f" stroke-opacity="0.55" stroke-width="2.5" stroke-linecap="round"/></svg>`,
          },
          {
            category: '新規事業',
            title: '共通ポイント導入プロダクト開発',
            client: '自社プロダクト',
            tags: ['#SaaS', '#DX', '#ポイントシステム'],
            svg: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg"><rect width="400" height="300" fill="#1d1d1f"/><g transform="translate(200,150)" fill="none"><circle r="105" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1.5"/><circle r="65" stroke="#ffffff" stroke-opacity="0.5" stroke-width="1.5"/><circle r="30" fill="#3e86fa"/><circle r="20" fill="none" stroke="#ffffff" stroke-width="2"/><line x1="-7" y1="-2" x2="7" y2="-2" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/><line x1="-7" y1="6" x2="7" y2="6" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/><circle cx="105" cy="0" r="7" fill="#ffffff"/><circle cx="-74" cy="74" r="7" fill="#ffffff"/><circle cx="65" cy="65" r="6" fill="#ffffff" fill-opacity="0.6"/><circle cx="-65" cy="0" r="6" fill="#ffffff"/><circle cx="0" cy="-105" r="5" fill="#ffffff" fill-opacity="0.6"/><circle cx="50" cy="-50" r="4" fill="#ffffff" fill-opacity="0.5"/></g></svg>`,
          },
          {
            category: 'AI',
            title: 'AI YouTuber開発',
            client: '自社プロダクト',
            tags: ['#AI', '#YouTuber', '#動画生成'],
            svg: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg"><rect width="400" height="300" fill="#1d1d1f"/><rect x="80" y="80" width="240" height="160" rx="14" fill="none" stroke="#ffffff" stroke-opacity="0.85" stroke-width="2"/><circle cx="200" cy="160" r="50" fill="#ffffff" fill-opacity="0.08" stroke="#ffffff" stroke-opacity="0.5" stroke-width="1.5"/><path d="M 188 138 L 230 160 L 188 182 Z" fill="#3e86fa"/><g stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-opacity="0.85"><path d="M 340 60 L 340 84 M 328 72 L 352 72"/></g><g stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-opacity="0.5"><path d="M 60 250 L 60 264 M 53 257 L 67 257"/></g><g stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-opacity="0.6"><path d="M 60 60 L 60 72 M 54 66 L 66 66"/></g></svg>`,
          },
        ].map(w => (
          <article class="work-card" data-animate>
            <div class="work-thumb">
              <div class="work-thumb-art" set:html={w.svg}></div>
              <span class="work-thumb-label">{w.category}</span>
            </div>
            <div class="work-body">
              <p class="work-client">{w.client}</p>
              <h3 class="work-title">{w.title}</h3>
              <ul class="work-tags">
                {w.tags.map(t => <li>{t}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== MESSAGE ===== -->
  <section class="section message-section">
    <div class="container message-inner">
      <div class="message-visual" data-animate>
        <div class="message-card">
          <img src="/logo.svg" alt="RANARIUM" class="message-logo" />
          <p class="message-quote">
            「カエルの跳躍のように、<br/>
            あるべき姿へ最短距離で。<br/>
            進化し続ける ——<br/>
            そんなLeapfroggingを、<br/>
            多くの事業に。」
          </p>
          <span class="message-sign">RANARIUM, Inc.</span>
        </div>
      </div>

      <div class="message-text">
        <div data-animate>
          <p class="section-eyebrow">MESSAGE</p>
          <h2 class="section-title-2">
            共に跳躍する、<br/>
            デジタル・パートナー。
          </h2>
        </div>
        <p class="message-body" data-animate>
          RANARIUMとは、ラテン語でカエルを意味する「Rana」と、
          水槽を意味する「Aquarium」を組み合わせた造語です。
          リープフロッグ型成長と呼ばれるような、ハードルを一気に飛び越える
          事業を創る、事業創出を支援することを目指しています。
        </p>
        <p class="message-body" data-animate>
          長く続く関係性の中で、同じ現場で戦い続ける。
          それが、私たちの目指すパートナーシップのかたちです。
        </p>
        <div data-animate>
          <a href="/about" class="btn-outline">
            会社概要を見る
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== NEWS ===== -->
  <section class="section news-section">
    <div class="container">
      <div class="section-header-2col" data-animate>
        <div class="section-heading-block">
          <p class="section-eyebrow">NEWS</p>
          <h2 class="section-title-2">
            最新のお知らせ
          </h2>
        </div>
      </div>

      <div data-animate>
        {[
          {
            date: '2026.04.27',
            cat: 'お知らせ',
            title: '法人設立 および ホームページ開設 のお知らせ',
            href: '/news/launch',
          },
        ].map(n => (
          <a href={n.href ?? '/news'} class="news-card">
            <div class="news-card-inner">
              <div class="news-meta">
                <time class="news-date">{n.date}</time>
                <span class="tag">{n.cat}</span>
              </div>
              <p class="news-title">{n.title}</p>
              <svg class="news-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <div class="news-cta" data-animate>
        <a href="/news" class="btn-outline news-all-link">
          すべて見る
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-section">
    <div class="container cta-inner" data-animate>
      <p class="section-eyebrow cta-eyebrow">CONTACT</p>
      <h2 class="cta-title">
        共に跳躍するパートナーへ。<br/>
        まずは、話すことから。
      </h2>
      <p class="cta-desc">
        無料相談・お見積りを承っております。<br/>
        小さな問いでも、曖昧な構想でも、どうぞお気軽に。
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary cta-btn">
          無料相談・お問い合わせ
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ============= HERO ============= */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 80px;
    background: transparent;
  }

  .hero-circles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circles .circle {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--color-border);
  }

  .hero-circles .circle-1 {
    width: 520px; height: 520px;
    right: -180px; top: 8%;
    opacity: 0.55;
  }
  .hero-circles .circle-2 {
    width: 280px; height: 280px;
    right: 12%; bottom: 8%;
    opacity: 0.35;
  }
  .hero-circles .circle-3 {
    width: 120px; height: 120px;
    left: 6%; top: 28%;
    background: var(--color-surface);
    border: none;
    opacity: 0.7;
  }

  .hero-frog-watermark {
    position: absolute;
    right: -4%;
    bottom: -6%;
    width: 38%;
    opacity: 0.05;
    pointer-events: none;
  }
  .hero-frog-watermark img { width: 100%; height: auto; }

  .hero-content {
    padding-top: 32px;
    padding-bottom: 80px;
    position: relative;
    z-index: 1;
    max-width: 1100px;
  }

  .hero-text { max-width: 760px; }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: lowercase;
    color: var(--color-ink-muted);
    margin-bottom: 28px;
  }
  .hero-eyebrow-line {
    display: block;
    width: 40px;
    height: 1px;
    background: var(--color-ink-muted);
  }

  .hero-heading {
    margin-bottom: 32px;
    color: var(--color-ink);
  }

  .hero-heading-en {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0.02em;
