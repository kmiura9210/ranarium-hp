---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    id: 'biz',
    num: '01',
    title: '新規事業開発',
    subtitle: 'Business Development',
    desc: 'ビジネスモデルの設計から、市場検証、事業計画策定、投資家向け資料作成まで。「何をやるか」を決める上流から、跳躍する事業の輪郭を描きます。',
    features: [
      'ビジネスモデルの設計・検証',
      '市場・競合リサーチと仮説検証',
      '事業計画書・投資家向け資料の作成',
      'KPI設計とユニットエコノミクス検討',
      '新規事業の体制構築・初期メンバー組成支援',
    ],
    icon: `<svg width="48" height="48" viewBox="0 0 48 48" fill="none"><path d="M8 36 L18 24 L26 30 L40 14" stroke="#1d1d1f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="40" cy="14" r="3" fill="#1d1d1f"/><circle cx="26" cy="30" r="2.5" fill="#1d1d1f"/><circle cx="18" cy="24" r="2.5" fill="#1d1d1f"/><circle cx="8" cy="36" r="2.5" fill="#1d1d1f"/></svg>`,
  },
  {
    id: 'pdm',
    num: '02',
    title: 'プロダクト開発PdM',
    subtitle: 'Product Management',
    desc: '要件定義、開発ベンダー選定、進行管理から、リリース後のグロース運用まで。スタートアップから大企業の新規事業部門まで、幅広い経験を活かしてプロダクトを形にします。',
    features: [
      '要件定義・仕様策定',
      '開発ベンダー選定・契約交渉',
      'スプリント設計とアジャイル進行管理',
      'リリース計画・QA・ユーザーテスト統括',
      'リリース後のKPIモニタリングとグロース運用',
    ],
    icon: `<svg width="48" height="48" viewBox="0 0 48 48" fill="none"><rect x="6" y="6" width="36" height="36" rx="6" stroke="#1d1d1f" stroke-width="1.8"/><line x1="6" y1="16" x2="42" y2="16" stroke="#1d1d1f" stroke-width="1.8"/><circle cx="11" cy="11" r="1.5" fill="#1d1d1f"/><circle cx="16" cy="11" r="1.5" fill="#1d1d1f"/><line x1="14" y1="24" x2="34" y2="24" stroke="#1d1d1f" stroke-width="1.8" stroke-linecap="round"/><line x1="14" y1="30" x2="28" y2="30" stroke="#1d1d1f" stroke-width="1.8" stroke-linecap="round"/><line x1="14" y1="36" x2="32" y2="36" stroke="#1d1d1f" stroke-width="1.8" stroke-linecap="round"/></svg>`,
  },
  {
    id: 'ai',
    num: '03',
    title: 'AIコンサルティング',
    subtitle: 'AI Consulting',
    desc: '戦略の絵を描くだけでなく、PoC実装、運用への定着まで踏み込みます。生成AIブームに振り回されず、「使えるAI活用」を設計・実装します。',
    features: [
      'AI活用戦略の立案・ロードマップ策定',
      '生成AI / 機械学習を活用したPoC設計・実装',
      '業務プロセスへのAI組み込みと運用定着支援',
      'AIプロダクトの企画・要件定義',
      '社内AI内製化のための体制・人材育成支援',
    ],
    icon: `<svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="18" stroke="#1d1d1f" stroke-width="1.8"/><path d="M14 30 L19 16 L24 25 L29 20 L34 30" stroke="#1d1d1f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/><circle cx="34" cy="14" r="2.5" fill="#1d1d1f"/><circle cx="14" cy="14" r="1.6" fill="#1d1d1f"/><circle cx="38" cy="34" r="1.6" fill="#1d1d1f"/></svg>`,
  },
];
---

<Layout title="サービス" description="株式会社RANARIUMのサービス一覧。新規事業開発、プロダクト開発PdM、AIコンサルティングを提供しています。">

  <!-- Page Hero -->
  <section class="page-hero services-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a><span>/</span><span>サービス</span>
      </nav>
      <div class="page-hero-inner animate-fade-in-up">
        <p class="section-label">Services</p>
        <h1 class="page-title">サービス</h1>
        <p class="page-subtitle">
          ビジネスモデルの設計から、プロダクトの実装、AI活用まで。<br/>
          新規事業を跳躍させるために必要な専門性を、一気通貫で提供します。
        </p>
      </div>
    </div>
  </section>

  <!-- Service List -->
  {services.map((s, i) => (
    <section id={s.id} class={`section service-detail ${i % 2 !== 0 ? 'alt-bg' : ''}`}>
      <div class="container service-detail-inner">
        <div class={`service-detail-content ${i % 2 !== 0 ? 'reversed' : ''}`}>

          <div class="service-text" data-animate>
            <div class="service-tag-row">
              <span class="service-num-badge">{s.num}</span>
              <span class="tag">{s.subtitle}</span>
            </div>
            <h2 class="service-detail-title">{s.title}</h2>
            <p class="service-detail-desc">{s.desc}</p>

            <ul class="service-features">
              {s.features.map(f => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <circle cx="8" cy="8" r="7" stroke="#1d1d1f" stroke-width="1.2"/>
                    <path d="M5 8l2 2 4-4" stroke="#1d1d1f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            <a href="/contact" class="btn-primary service-cta">
              このサービスについて相談する
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <div class="service-visual" data-animate style={`animation-delay: 0.15s`}>
            <div class="service-visual-inner">
              <div class="service-visual-num">{s.num}</div>
              <div class="service-icon-large" set:html={s.icon}></div>
              <h3 class="service-visual-title">{s.title}</h3>
              <p class="service-visual-en">{s.subtitle}</p>
            </div>
          </div>

        </div>
      </div>
    </section>
  ))}

  <!-- Process -->
  <section class="section process-section">
    <div class="container">
      <div class="process-header" data-animate>
        <p class="section-label">Process</p>
        <h2 class="section-title">ご支援の流れ</h2>
      </div>

      <div class="process-steps">
        {[
          { num: '01', title: 'ヒアリング',     desc: '事業の構想・課題・目標を丁寧にお伺いします。初回相談は無料です。' },
          { num: '02', title: '提案・見積り',   desc: 'ご状況に合わせた最適な関わり方と費用感をご提案します。' },
          { num: '03', title: '契約・キックオフ', desc: 'ご契約後、必要なメンバーを揃えてプロジェクトを開始します。' },
          { num: '04', title: '伴走・実行',     desc: '定期的な進捗共有を行いながら、現場で手を動かして進めます。' },
          { num: '05', title: 'リリース・運用', desc: 'リリース後も継続して伴走し、改善のサイクルを回します。' },
        ].map((step, i) => (
          <div class="process-step" data-animate style={`animation-delay: ${i * 0.1}s`}>
            <div class="process-circle">
              <span>{step.num}</span>
            </div>
            {i < 4 && <div class="process-arrow" aria-hidden="true"></div>}
            <div class="process-info">
              <h3 class="process-title">{step.title}</h3>
              <p class="process-desc">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-mini">
    <div class="container cta-mini-inner" data-animate>
      <p>まずはお気軽にご相談ください</p>
      <a href="/contact" class="btn-primary">
        無料相談・お問い合わせ
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 140px 0 80px;
    position: relative;
    overflow: hidden;
    background: transparent;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    margin-bottom: 32px;
  }

  .breadcrumb a { color: var(--color-ink-muted); text-decoration: none; transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--color-ink); }

  .page-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.95;
  }

  .section-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .service-detail { background: transparent; }
  .alt-bg { background: transparent; }

  /* Service detail */
  .service-detail-inner { max-width: 1100px; margin: 0 auto; }

  .service-detail-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .service-detail-content.reversed .service-text { order: 2; }
  .service-detail-content.reversed .service-visual { order: 1; }

  .service-tag-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .service-num-badge {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: 0.18em;
  }

  .service-detail-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    margin-bottom: 20px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .service-detail-desc {
    font-size: 0.97rem;
    color: var(--color-ink-soft);
    line-height: 1.95;
    margin-bottom: 32px;
  }

  .service-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 36px;
  }

  .service-features li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .service-features li svg { flex-shrink: 0; margin-top: 3px; }

  .service-cta { display: inline-flex; }

  /* Service visual card (monochrome) */
  .service-visual {
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: 0;
    overflow: hidden;
    min-height: 320px;
    display: flex;
    align-items: stretch;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s, border-color 0.35s;
  }
  .service-visual:hover {
    transform: translateY(-4px);
    border-color: var(--color-ink-soft);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
  }

  .service-visual-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 56px 32px;
    position: relative;
    text-align: center;
  }

  .service-icon-large { width: 48px; height: 48px; }

  .service-visual-num {
    font-family: var(--font-display);
    font-size: 5.5rem;
    font-weight: 300;
    color: var(--color-surface-2);
    position: absolute;
    top: 20px;
    right: 28px;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    letter-spacing: 0.02em;
  }

  .service-visual-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    margin-top: 8px;
  }

  .service-visual-en {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--color-ink-muted);
    text-transform: uppercase;
  }

  /* Process */
  .process-section { background: transparent; }
  .process-header { margin-bottom: 56px; }
  .process-section .section-label { display: inline-flex; }

  .process-steps {
    display: flex;
    gap: 0;
    align-items: flex-start;
    position: relative;
  }

  .process-step {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  .process-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .process-step:hover .process-circle {
    border-color: var(--color-ink-soft);
    transform: translateY(-2px);
  }

  .process-circle span {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    letter-spacing: 0.1em;
  }

  .process-arrow {
    position: absolute;
    top: 28px;
    right: -8px;
    width: calc(100% - 32px);
    height: 1px;
    background: var(--color-border);
    z-index: 0;
    transform: translateX(36px);
  }

  .process-info { padding: 0 16px; }

  .process-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--color-ink);
  }

  .process-desc {
    font-size: 0.82rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  /* CTA mini */
  .cta-mini { background: transparent; }

  .cta-mini-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 40px 48px;
    background: var(--color-ink);
    border-radius: 4px;
  }

  .cta-mini-inner p {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .cta-mini-inner .btn-primary {
    background: #ffffff;
    color: var(--color-ink);
  }
  .cta-mini-inner .btn-primary:hover {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  @media (max-width: 900px) {
    .service-detail-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .service-detail-content.reversed .service-text  { order: 1; }
    .service-detail-content.reversed .service-visual { order: 2; }

    .process-steps {
      flex-direction: column;
      gap: 24px;
      align-items: stretch;
    }
    .process-step { flex-direction: row; text-align: left; gap: 20px; }
    .process-circle { flex-shrink: 0; margin-bottom: 0; }
    .process-arrow { display: none; }
  }

  @media (max-width: 640px) {
    .cta-mini-inner {
      flex-direction: column;
      text-align: center;
      padding: 32px 24px;
    }
  }
</style>
