---
import Layout from '../layouts/Layout.astro';
---

<Layout title="お問い合わせ" description="株式会社RANARIUMへのお問い合わせはこちら。無料相談・お見積りも受け付けています。">

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a><span>/</span><span>お問い合わせ</span>
      </nav>
      <div class="page-hero-inner animate-fade-in-up">
        <p class="section-label">Contact</p>
        <h1 class="page-title">お問い合わせ</h1>
        <p class="page-subtitle">
          サービスへのご質問・無料相談・お見積りなど、<br/>
          どんな小さなことでもお気軽にご連絡ください。<br/>
          通常2営業日以内にご返信いたします。
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="section contact-section">
    <div class="container contact-inner">

      <div class="contact-form-wrap" data-animate>
        <div class="form-card">
          <h2 class="form-heading">お問い合わせフォーム</h2>

          <form id="contact-form" class="contact-form" novalidate>
            <div class="form-row">
              <div class="form-field">
                <label class="form-label" for="name">
                  お名前 <span class="required">必須</span>
                </label>
                <input
                  class="form-input"
                  type="text"
                  id="name"
                  name="name"
                  placeholder="山田 太郎"
                  required
                  autocomplete="name"
                />
              </div>
              <div class="form-field">
                <label class="form-label" for="company">
                  会社名 <span class="required">必須</span>
                </label>
                <input
                  class="form-input"
                  type="text"
                  id="company"
                  name="company"
                  placeholder="株式会社〇〇"
                  required
                  autocomplete="organization"
                />
              </div>
            </div>

            <div class="form-row">
              <div class="form-field">
                <label class="form-label" for="email">
                  メールアドレス <span class="required">必須</span>
                </label>
                <input
                  class="form-input"
                  type="email"
                  id="email"
                  name="email"
                  placeholder="taro@example.com"
                  required
                  autocomplete="email"
                />
              </div>
              <div class="form-field">
                <label class="form-label" for="phone">電話番号</label>
                <input
                  class="form-input"
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="03-0000-0000"
                  autocomplete="tel"
                />
              </div>
            </div>

            <div class="form-field">
              <label class="form-label" for="service">ご興味のあるサービス</label>
              <select class="form-input form-select" id="service" name="service">
                <option value="">選択してください</option>
                <option value="biz">新規事業開発</option>
                <option value="pdm">プロダクト開発PdM</option>
                <option value="ai">AIコンサルティング</option>
                <option value="other">その他・複数のサービス</option>
              </select>
            </div>

            <div class="form-field">
              <label class="form-label" for="message">
                お問い合わせ内容 <span class="required">必須</span>
              </label>
              <textarea
                class="form-input"
                id="message"
                name="message"
                placeholder="ご相談内容・ご質問をご記入ください。"
                required
                rows="6"
              ></textarea>
            </div>

            <div class="form-privacy">
              <label class="privacy-label">
                <input type="checkbox" id="privacy" name="privacy" required />
                <span class="privacy-check"></span>
                <span>
                  <a href="/privacy" target="_blank" rel="noopener">プライバシーポリシー</a>に同意する
                </span>
              </label>
            </div>

            <button type="submit" class="btn-primary submit-btn" id="submit-btn">
              送信する
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </form>

          <!-- Success state -->
          <div class="form-success" id="form-success" aria-live="polite">
            <div class="success-icon">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                <circle cx="24" cy="24" r="22" stroke="#1d1d1f" stroke-width="2"/>
                <path d="M14 24l8 8 12-16" stroke="#1d1d1f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3>送信が完了しました</h3>
            <p>お問い合わせありがとうございます。<br/>通常2営業日以内にご返信いたします。</p>
            <a href="/" class="btn-outline" style="margin-top: 16px;">トップに戻る</a>
          </div>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 140px 0 60px;
    position: relative;
    overflow: hidden;
    background: transparent;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    margin-bottom: 32px;
  }

  .breadcrumb a { color: var(--color-ink-muted); text-decoration: none; transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--color-ink); }

  .page-hero-inner { max-width: 720px; }

  .page-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.95;
  }

  /* Contact layout */
  .contact-section {
    background: transparent;
    padding-top: 24px;
  }

  .contact-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  /* Form card */
  .form-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: 48px 44px;
  }

  .form-heading {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 32px;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .required {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    color: #c0392b;
    background: rgba(192, 57, 43, 0.08);
    border-radius: 2px;
    padding: 2px 6px;
    margin-left: 6px;
    vertical-align: middle;
    letter-spacing: 0.04em;
  }

  .form-select {
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%2386868b' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 16px center;
    padding-right: 40px;
    cursor: pointer;
  }

  /* Privacy checkbox */
  .form-privacy {
    margin-top: -4px;
  }

  .privacy-label {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    font-size: 0.88rem;
    color: var(--color-ink-soft);
  }

  .privacy-label input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .privacy-check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--color-border);
    border-radius: 2px;
    background: white;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .privacy-label input:checked + .privacy-check {
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .privacy-label input:checked + .privacy-check::after {
    content: '';
    display: block;
    width: 10px;
    height: 6px;
    border-left: 2px solid white;
    border-bottom: 2px solid white;
    transform: rotate(-45deg) translate(1px, -1px);
  }

  .privacy-label a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .submit-btn {
    width: 100%;
    padding: 17px;
    font-size: 1rem;
    margin-top: 4px;
  }

  /* Success */
  .form-success {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 32px 0;
    animation: fade-in-up 0.6s ease-out both;
  }

  .form-success.visible {
    display: flex;
  }

  .form-success h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .form-success p {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    line-height: 1.85;
  }

  @media (max-width: 560px) {
    .form-card { padding: 32px 24px; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Loading state
    submitBtn.disabled = true;
    submitBtn.textContent = '送信中...';

    // Simulate send (replace with actual API endpoint)
    await new Promise(resolve => setTimeout(resolve, 1200));

    form.style.display = 'none';
    success.classList.add('visible');
  });
</script>
