---
const year = new Date().getFullYear();

const links = [
  {
    heading: 'サービス',
    items: [
      { label: '新規事業開発',         href: '/services#biz' },
      { label: 'プロダクト開発PdM',    href: '/services#pdm' },
      { label: 'AIコンサルティング',   href: '/services#ai'  },
    ],
  },
  {
    heading: '会社情報',
    items: [
      { label: '会社概要',   href: '/about'   },
      { label: 'お知らせ',   href: '/news'    },
      { label: 'お問い合わせ', href: '/contact' },
    ],
  },
];
---

<footer>
  <div class="footer-divider" aria-hidden="true"></div>

  <div class="footer-body">
    <div class="container">
      <div class="footer-grid">

        <!-- Brand -->
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <img src="/logo.png" alt="RANARIUM" class="footer-logo-img" />
            <span>RANARIUM</span>
          </a>
          <p class="footer-tagline">
            AI・ITで、<br/>跳躍する事業を育てる。
          </p>
          <a href="/contact" class="btn-primary footer-cta">
            お問い合わせ
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
              <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <!-- Links -->
        {links.map(group => (
          <div class="footer-link-group">
            <p class="footer-link-heading">{group.heading}</p>
            <ul>
              {group.items.map(item => (
                <li><a href={item.href} class="footer-link">{item.label}</a></li>
              ))}
            </ul>
          </div>
        ))}

        <!-- Contact info -->
        <div class="footer-link-group">
          <p class="footer-link-heading">連絡先</p>
          <ul class="footer-contact">
            <li>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M2 4h12v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4zm0 0l6 5 6-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
              info@ranarium.co.jp
            </li>
          </ul>
        </div>

      </div>

      <div class="footer-bottom">
        <p class="footer-copy">&copy; {year} 株式会社RANARIUM. All Rights Reserved.</p>
        <div class="footer-bottom-links">
          <a href="/privacy">プライバシーポリシー</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: 0;
  }

  .footer-divider {
    height: 1px;
    background: var(--color-border);
  }

  .footer-body {
    background: var(--color-surface);
    color: var(--color-ink-soft);
    padding: 60px 0 40px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1.3fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--color-border);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    margin-bottom: 16px;
  }

  .footer-logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    transform-origin: 50% 100%;
    will-change: transform;
  }

  .footer-logo:hover .footer-logo-img {
    animation: frog-jump-soft 0.7s cubic-bezier(0.34, 1.4, 0.64, 1) 1;
  }

  .footer-tagline {
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--color-ink-muted);
    margin-bottom: 24px;
  }

  .footer-cta {
    padding: 10px 22px;
    font-size: 0.82rem;
    display: inline-flex;
  }

  .footer-link-heading {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 16px;
  }

  .footer-link-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--color-ink);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    line-height: 1.5;
  }

  .footer-contact li svg {
    flex-shrink: 0;
    margin-top: 2px;
    opacity: 0.5;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 28px;
  }

  .footer-copy {
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    letter-spacing: 0.02em;
  }

  .footer-bottom-links {
    display: flex;
    gap: 24px;
  }

  .footer-bottom-links a {
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-bottom-links a:hover {
    color: var(--color-ink);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
